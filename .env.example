# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin Panel Authentication (recommended in production / Vercel)
ADMIN_PASSWORD=""
ADMIN_SECRET=""

# Optional Vercel Permanent Storage (Upstash / Vercel KV REST API)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Optional Default Site & Meta Pixel Env Overrides (useful on Vercel)
APP_NAME=""
WEBSITE_URL=""
APK_URL=""
WHATSAPP_NUMBER=""
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""
